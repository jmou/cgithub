<div class="box release">
  <header>
    <% if (it.linkToDetail) { %>
      <a href="/<%= it.repo.owner %>/<%= it.repo.name %>/releases/tag/<%= it.release.tagName %>">
        <%= it.release.title %>
      </a>
    <% } else { %>
      <span><%= it.release.title %></span>
    <% } %>
    <% if (it.release.publishedAt) { %>
      <time class="timestamp" title="<%= it.release.publishedAt %>">
        <%= it.release.publishedAt.split("T")[0] %>
      </time>
    <% } %>
  </header>
  <% if (it.release.bodyHtml) { %>
    <%~ it.release.bodyHtml %>
  <% } %>
  <% if (it.release.assets && it.release.assets.length > 0) { %>
    <footer>
      <h3>Assets</h3>
      <% for (const asset of it.release.assets) { %>
        <div>
          <a href="<%= asset.url %>"><%= asset.name %></a>
          <% if (asset.publishedAt) { %>
            <time class="timestamp" title="<%= asset.publishedAt %>"><%= asset.publishedAt.split("T")[0] %></time>
          <% } %>
        </div>
      <% } %>
    </footer>
  <% } %>
</div>
