<div class="box release">
  <header>
    <span>
      <% if (it.linkToDetail) { %>
        <a href="/<%= it.repo.owner %>/<%= it.repo.name %>/releases/tag/<%= it.release.tagName %>"><%= it.release.title %></a>
      <% } else { %>
        <%= it.release.title %>
      <% } %>
      <% if (it.release.isLatest) { %>
        <span class="pill state state-open">Latest</span>
      <% } %>
    </span>
    <% if (it.release.author) { %>
      <a class="release-detail" href="<%= it.release.authorUrl %>"><%= it.release.author %></a>
    <% } %>
    <% if (it.release.commitOid) { %>
      <a class="release-detail" href="/<%= it.repo.owner %>/<%= it.repo.name %>/commit/<%= it.release.commitOid %>"><code><%= it.release.commitOid.slice(0, 7) %></code></a>
    <% } %>
    <% if (it.release.publishedAt) { %>
      <time class="timestamp" title="<%= it.release.publishedAt %>">
        <%= it.release.publishedAt.split("T")[0] %>
      </time>
    <% } %>
  </header>
  <% if (it.release.bodyHtml) { %>
    <%~ it.release.bodyHtml %>
  <% } %>
  <% if (it.release.assets && it.release.assets.length > 0) { %>
    <footer>
      <h3>Assets</h3>
      <% for (const asset of it.release.assets) { %>
        <div>
          <a href="<%= asset.url %>"><%= asset.name %></a>
          <% if (asset.publishedAt) { %>
            <time class="timestamp" title="<%= asset.publishedAt %>"><%= asset.publishedAt.split("T")[0] %></time>
          <% } %>
        </div>
      <% } %>
    </footer>
  <% } %>
</div>
