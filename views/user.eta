<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.name ? `${it.name} (${it.login})` : it.login %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="box repo-info">
    <% if (it.avatarUrl) { %>
      <img class="avatar" src="<%= it.avatarUrl %>" alt="" width="64" height="64">
    <% } %>
    <div class="repo"><%= it.name || it.login %></div>
    <div class="detail"><%= it.login %></div>
    <% if (it.bio) { %>
      <div class="description"><%= it.bio %></div>
    <% } %>
    <% if (it.followers) { %>
      <div class="detail"><img src="/static/icons/eye.svg" alt="" class="icon"> <%= it.followers %> followers<%= it.following ? ` · ${it.following} following` : "" %></div>
    <% } %>
    <% if (it.company) { %>
      <div class="detail"><%= it.company %></div>
    <% } %>
    <% if (it.location) { %>
      <div class="detail"><%= it.location %></div>
    <% } %>
    <% for (const link of it.links) { %>
      <div class="detail"><img src="/static/icons/link.svg" alt="" class="icon"> <a href="<%= link.href %>" rel="noopener noreferrer"><%= link.text %></a></div>
    <% } %>
  </div>

  <% if (it.pinned.length > 0) { %>
    <section>
      <h2>Pinned</h2>
      <% for (const repo of it.pinned) { %>
        <div class="box repo-info">
          <div><a href="/<%= repo.owner %>/<%= repo.name %>"><%= repo.owner === it.login ? repo.name : `${repo.owner}/${repo.name}` %></a></div>
          <% if (repo.description) { %>
            <div class="description"><%= repo.description %></div>
          <% } %>
          <% if (repo.language) { %>
            <span class="detail"><%= repo.language %></span>
          <% } %>
          <% if (repo.stars) { %>
            <span class="detail"><img src="/static/icons/star.svg" alt="stars" class="icon"> <%= repo.stars %></span>
          <% } %>
          <% if (repo.forks) { %>
            <span class="detail"><img src="/static/icons/git-fork.svg" alt="forks" class="icon"> <%= repo.forks %></span>
          <% } %>
        </div>
      <% } %>
    </section>
  <% } %>

  <footer>Generated by cgithub</footer>
</body>
</html>
