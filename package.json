{
  "name": "cgithub",
  "version": "1.0.0",
  "description": "Lightweight GitHub alternative frontend",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output src/index.ts",
    "build": "rm -rf dist/* && esbuild --bundle --format=esm --platform=node --outdir=dist/build --sourcemap src/index.ts && cp -R public views dist/",
    "test": "node --test --test-concurrency=4 src/scraper.test.ts",
    "dev:cf": "node scripts/compile-views.ts && wrangler dev",
    "deploy:cf": "node scripts/compile-views.ts && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "css-select": "^6.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "eta": "^3.5.0",
    "hono": "^4.6.14",
    "htmlparser2": "^10.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.27.2",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.110.0"
  }
}
